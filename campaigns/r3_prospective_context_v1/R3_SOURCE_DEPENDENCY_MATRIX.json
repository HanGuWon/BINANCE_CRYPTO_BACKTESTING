{
  "schema": "r3-source-dependency-matrix-v1",
  "primary": {
    "R3_H01": {"stream":"klines_15m","endpoint":"/fapi/v1/klines","fields":["open_time","open","high","low","close","volume","close_time"],"transformation":"closed 15m OHLCV","timing":"availability=max(close_time, corrected_response_receipt_time); strict < next executable open","warmup":"one closed bar","gap":"reset segment; ineligible","primary_required":true},
    "R3_H02": {"stream":"premium_klines_15m","endpoint":"/fapi/v1/premiumIndexKlines","fields":["open_time","close","close_time"],"transformation":"most recent fully closed premium index value","timing":"availability=max(close_time, corrected_response_receipt_time)","warmup":"one closed bar","gap":"reset segment; ineligible","primary_required":true},
    "R3_H03": {"stream":"forceOrder","endpoint":"wss://fstream.binance.com/market/ws/!forceOrder@arr","fields":["e","E","o.s","o.S","o.q","o.l","o.z","o.p","o.ap","o.ps","o.st"],"transformation":"observed_forceorder_pressure","timing":"exchange event plus corrected receipt","warmup":"none","gap":"explicit stream/restart gap; never zero-impute","primary_required":true},
    "R3_H04": {"stream":"forceOrder","endpoint":"wss://fstream.binance.com/market/ws/!forceOrder@arr","fields":["e","E","o.s","o.S","o.q","o.l","o.z","o.p","o.ap","o.ps","o.st"],"transformation":"same observed pressure, contrarian response sign","timing":"exchange event plus corrected receipt","warmup":"none","gap":"explicit stream/restart gap; never zero-impute","primary_required":true},
    "R3_H05": {"stream":"premium","endpoint":"/fapi/v1/premiumIndex","fields":["lastFundingRate"],"transformation":"funding_rate_t=lastFundingRate; paired premium_t from H02 completed premium kline","timing":"both sources must be available before next executable open","warmup":"both values present","gap":"missing either yields NaN/ineligible","primary_required":true},
